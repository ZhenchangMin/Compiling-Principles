FUNCTION add :
PARAM v1
t1 := *v1
t2 := v1 + #4
t3 := *t2
t4 := t1 + t3
RETURN t4
FUNCTION main :
DEC v2 8
DEC v3 8
v4 := #0
v5 := #0
LABEL label1 :
IF v4 >= #2 GOTO label3
LABEL label2 :
LABEL label4 :
IF v5 >= #2 GOTO label6
LABEL label5 :
t5 := v5 * #4
t6 := &v2 + t5
t7 := v4 + v5
*t6 := t7
v5 := v5 + #1
GOTO label4
LABEL label6 :
t9 := &v3
t10 := v4 * #4
t11 := t9 + t10
ARG &v2
t12 := CALL add
*t11 := t12
t13 := &v3
t14 := v4 * #4
t15 := t13 + t14
t16 := *t15
WRITE t16
v4 := v4 + #1
v5 := #0
GOTO label1
LABEL label3 :
RETURN #0
